# App
APP_ENV=development
SECRET_KEY=change-me-to-a-secure-random-string-in-production
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_MINI_APP_URL=https://your-frontend.vercel.app
OWNER_TELEGRAM_ID=your_telegram_user_id

# Database (PostgreSQL)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/grow_with_me

# OpenAI API
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS_PER_DAY=50000

# Server
HOST=0.0.0.0
PORT=8000
